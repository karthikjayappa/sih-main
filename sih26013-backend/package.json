{
  "name": "sih26013-land-conflation-backend",
  "version": "1.0.0",
  "description": "SIH26013 - Automated Integration & Harmonization of Multi-source Geospatial Data for Urban Land Records",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node db/seed/run-migrations.js",
    "seed:mapping-profiles": "node db/seed/seed-mapping-profiles.js",
    "seed:sample-data": "node db/seed/generate-sample-data.js",
    "setup": "npm run migrate && npm run seed:mapping-profiles && npm run seed:sample-data"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "csv-parse": "^5.5.6",
    "xlsx": "^0.18.5",
    "joi": "^17.13.3",
    "uuid": "^9.0.1",
    "@turf/turf": "^6.5.0",
    "morgan": "^1.10.0"
  }
}
