# --- Server ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL / PostGIS ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=land_conflation
PGUSER=postgres
PGPASSWORD=postgres

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# --- Conflation thresholds ---
CONFLATION_DISTANCE_METERS=5
AREA_MISMATCH_THRESHOLD_PCT=10
GEOMETRY_OVERLAP_MIN_RATIO=0.6
